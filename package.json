{
  "name": "lineage-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive data lineage explorer prototype",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:data": "node scripts/generate-dataset.mjs",
    "predev": "npm run generate:data",
    "dev": "vite",
    "build": "npm run generate:data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate:lineage-html": "python3 scripts/validate_lineage_html_content.py",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "node-html-parser": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.11",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
