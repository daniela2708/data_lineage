          "text": "3. df_build_update_points_earn_fl (DEP_6).",
        },
        {
          "id": "note_c2b0eb2b6db27b0f8776",
          "text": "Same frozen table limit as step 1.",
        },
        {
          "id": "note_abf1110208ae94eb5315",
          "text": "Trigger",
        },
        {
          "id": "note_bb44f09055d1de202d31",
          "text": "Assigns CLUB_CARD_KEY automatically on every",
        },
