        {
          "id": "note_8864f8b2605a7aa0d3c1",
          "text": "Post-load steps, on the loaded table",
        },
        {
          "id": "note_82d4ab1c69866a77aab0",
          "text": "1. df_build_update_household_fl (DEP_4). Only",
        },
        {
